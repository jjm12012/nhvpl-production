# Database
DATABASE_URL="postgresql://user:password@host:5432/nhvpl_db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Payment
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_test_your_webhook_secret"

# PayPal Payment
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_MODE="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_client_id"

# Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@newhavenpickleball.com"
# Receives merch order notifications (falls back to league contact if unset)
ADMIN_EMAIL="admin@newhavenpickleball.com"

# Seed Data
ADMIN_SEED_EMAIL="admin@newhavenpickleball.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
