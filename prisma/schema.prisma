// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE_A
  INTERMEDIATE_B
  ADVANCED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  STRIPE_CARD
  STRIPE_APPLE_PAY
  STRIPE_GOOGLE_PAY
  PAYPAL
}

enum ContentFormat {
  TEXT
  MARKDOWN
}

enum FormType {
  LEAGUE
  MERCHANDISE
}

model Event {
  id                String         @id @default(cuid())
  name              String
  description       String?
  season            String
  year              Int
  startDate         DateTime
  endDate           DateTime
  registrationOpen  DateTime
  registrationClose DateTime
  price             Decimal        @db.Decimal(10, 2)
  currency          String         @default("USD")
  maxBeginner       Int?
  maxIntermediateA  Int?
  maxIntermediateB  Int?
  maxAdvanced       Int?
  location          String?
  dayOfWeek         String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  registrations     Registration[]

  // Merchandise order form support. formType selects which public form the
  // event renders; existing events default to LEAGUE with NULL merch fields.
  formType          FormType           @default(LEAGUE)
  unitPrice         Decimal?           @db.Decimal(10, 2) // price per shirt
  availableColors   String[]           @default([]) // e.g. ['Navy', 'White', 'Grey']
  orderOpenDate     DateTime?
  orderCloseDate    DateTime?
  merchandiseOrders MerchandiseOrder[]

  @@index([isActive])
  @@index([year, season])
}

// One row per submitted shirt order. No cart/multi-item logic: each form
// submission = one Stripe transaction = one row here. Rows are written by the
// Stripe webhook (and the success-page confirm endpoint, idempotently) only
// after payment succeeds.
model MerchandiseOrder {
  id                    String   @id @default(cuid())
  eventId               String
  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  name                  String
  email                 String
  size                  String
  color                 String
  quantity              Int      @default(1)
  unitPrice             Decimal  @db.Decimal(10, 2)
  totalAmount           Decimal  @db.Decimal(10, 2) // quantity * unitPrice
  stripeSessionId       String?  @unique
  stripePaymentIntentId String?
  stripePaymentStatus   String   @default("pending") // 'pending' | 'paid' | 'refunded'

  @@index([eventId])
  @@index([email])
}

model Registration {
  id                    String         @id @default(cuid())
  eventId               String
  event                 Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  email                 String
  phone                 String
  division              SkillLevel
  canCommit             Boolean
  interestedInCaptain   Boolean        @default(false)
  willingToMonitor      Boolean        @default(false)
  teamPreference        String?
  liabilityAck          Boolean
  funAck                Boolean
  paymentStatus         PaymentStatus  @default(PENDING)
  paymentMethod         PaymentMethod?
  stripeSessionId       String?        @unique
  stripePaymentIntentId String?        @unique
  paypalOrderId         String?        @unique
  amountPaid            Decimal?       @db.Decimal(10, 2)
  paidAt                DateTime?
  ipAddress             String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([email])
  @@index([eventId])
  @@index([paymentStatus])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Admin-editable site content. Each row is a single editable piece of text
// keyed by a stable string (e.g. "register_form_title"). Public pages look
// content up by key and fall back to a built-in default if a row is missing,
// so the site never breaks when a key is absent. `page` groups blocks for the
// admin UI; `format` selects plain-text vs. sanitized markdown rendering.
// Keys are seed-defined and edit-only — admins cannot create or delete keys.
model ContentBlock {
  id        String        @id @default(cuid())
  key       String        @unique
  page      String
  label     String
  value     String        @db.Text
  format    ContentFormat @default(TEXT)
  updatedBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([page])
}
